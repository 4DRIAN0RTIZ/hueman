{#-
  Newt/whiptail palette via NEWT_COLORS_FILE.
  Generated by hueman — do not edit the output file by hand.

  - Format: element=fg,bg. Output has no comments: newt would parse them as elements.
  - Hex colors need COLORTERM=truecolor (slang >= 2.3).
  - Every element is set: NEWT_COLORS_FILE replaces /etc/newt/palette, and an
    omitted element falls back to newt defaults (blue/red).
-#}
root={{ foreground }},{{ background }}
roottext={{ muted }},{{ background }}
helpline={{ foreground }},{{ background_alt }}
shadow={{ background }},{{ background }}
window={{ foreground }},{{ background_alt }}
border={{ secondary }},{{ background_alt }}
title={{ primary }},{{ background_alt }}
label={{ foreground }},{{ background_alt }}
textbox={{ foreground }},{{ background_alt }}
acttextbox={{ background }},{{ secondary }}
button={{ foreground }},{{ muted }}
actbutton={{ background }},{{ primary }}
compactbutton={{ foreground }},{{ background_alt }}
checkbox={{ foreground }},{{ background_alt }}
actcheckbox={{ background }},{{ primary }}
entry={{ foreground }},{{ background }}
disentry={{ muted }},{{ background }}
listbox={{ foreground }},{{ background_alt }}
actlistbox={{ background }},{{ primary }}
sellistbox={{ secondary }},{{ background_alt }}
actsellistbox={{ background }},{{ primary }}
emptyscale={{ muted }},{{ background }}
fullscale={{ background }},{{ primary }}
