{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi-mono/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "{{ theme_name }}",
  "vars": {{ vars | tojson(indent=2) }},
  "colors": {
    "accent": "orange",
    "border": "floatingBg",
    "borderAccent": "orange",
    "borderMuted": "elevatedBg",
    "success": "green",
    "error": "redEarth",
    "warning": "sand",
    "muted": "textMuted",
    "dim": "dimGray",
    "text": "",
    "thinkingText": "thinkingColor",

    "selectedBg": "floatingBg",
    "userMessageBg": "elevatedBg",
    "userMessageText": "textPrimary",
    "customMessageBg": "elevatedBg",
    "customMessageText": "textPrimary",
    "customMessageLabel": "orange",

    "toolPendingBg": "baseBg",
    "toolSuccessBg": "#1f301f",
    "toolErrorBg": "#2a1e1e",
    "toolTitle": "orange",
    "toolOutput": "textPrimary",

    "mdHeading": "orange",
    "mdLink": "sand",
    "mdLinkUrl": "textMuted",
    "mdCode": "orange",
    "mdCodeBlock": "textPrimary",
    "mdCodeBlockBorder": "floatingBg",
    "mdQuote": "textSecondary",
    "mdQuoteBorder": "green",
    "mdHr": "textMuted",
    "mdListBullet": "orange",

    "toolDiffAdded": "green",
    "toolDiffRemoved": "redEarth",
    "toolDiffContext": "textMuted",

    "syntaxComment": "textMuted",
    "syntaxKeyword": "orange",
    "syntaxFunction": "sand",
    "syntaxVariable": "textSecondary",
    "syntaxString": "green",
    "syntaxNumber": "sand",
    "syntaxType": "brown",
    "syntaxOperator": "orange",
    "syntaxPunctuation": "textMuted",

    "thinkingOff": "textMuted",
    "thinkingMinimal": "sand",
    "thinkingLow": "brown",
    "thinkingMedium": "orange",
    "thinkingHigh": "redEarth",
    "thinkingXhigh": "#ff3b3b",

    "bashMode": "green"
  }
}
