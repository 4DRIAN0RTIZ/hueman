// ==UserScript==
// @name         Google theme
// @description  Generated by theme_manager.py from the active palette. Do not edit by hand.
// @match        *://www.google.com/
// @match        *://www.google.com/?*
// @match        *://www.google.com/webhp*
// @match        *://www.google.com/search*
// @run-at       document-start
// ==/UserScript==

(function () {
  const CSS = `
/* Google homepage: surfaces and text come from obfuscated custom properties
   defined on :root and re-defined on scoped containers (.X1pLC, .iZKbPe). */
:root,
.X1pLC,
.iZKbPe,
body {
  color-scheme: dark !important;

  /* Surfaces */
  --xhUGwc: {{ background }} !important;
  --EpFNW: {{ background }} !important;
  --ZXiaGf: {{ background }} !important;
  --EoKObe: {{ background_alt }} !important;
  --cIehld: {{ background_alt }} !important;
  --CwQ7J: {{ background }} !important;
  --DEeStf: {{ background_alt }} !important;
  --TSWZIb: {{ background_alt }} !important;
  --BRLwE: {{ muted }} !important;
  --XKMDxc: {{ background_alt }} !important;
  --aYn2S: {{ background_alt }} !important;
  --Lm570b: {{ muted }} !important;
  --jwFC2e: {{ muted }} !important;

  /* Text */
  --YLNNHc: {{ foreground }} !important;
  --COEmY: {{ foreground }} !important;
  --Xqboce: {{ foreground }} !important;
  --jINu6c: {{ foreground }} !important;
  --bbQxAb: {{ foreground }} !important;
  --IXoxUe: {{ foreground }}b3 !important;
  --amnPwe: {{ foreground }}b3 !important;
  --uLz37c: {{ foreground }}b3 !important;

  /* Accents and links */
  --TMYS9: {{ primary }} !important;
  --TyVYld: {{ primary }} !important;
  --Nsm0ce: {{ primary }} !important;
  --rrJJUc: {{ primary }} !important;
  --JKqx2: {{ secondary }} !important;
  --vZe0jb: {{ primary }} !important;
  --nwXobb: {{ primary }} !important;
  --ZEpPmd: {{ primary }} !important;
  --QWaaaf: {{ primary }} !important;
  --vdwxpe: {{ primary }} !important;

  /* Borders */
  --gS5jXb: {{ muted }} !important;
  --Aqn7xd: {{ muted }} !important;
  --mXZkqc: {{ muted }} !important;
  --JclFj: {{ muted }} !important;
  --ONhrGd: {{ muted }} !important;
}

html, body { background: {{ background }} !important; color: {{ foreground }} !important; }

/* Hardcoded colors the variables do not reach */
body #gb .gb_R, body header#gb { background: transparent !important; }
body .RNNXgb { border-color: {{ muted }} !important; background: {{ background_alt }} !important; box-shadow: none !important; }
body .sbfc .RNNXgb,
body .emcav .RNNXgb,
body .BgPPrc .RNNXgb { border-color: {{ primary }} !important; background: {{ background_alt }} !important; }
body .aajZCb { background: {{ background_alt }} !important; border-color: {{ muted }} !important; box-shadow: none !important; }
body textarea.gLFyf, body .gLFyf { color: {{ foreground }} !important; background: transparent !important; caret-color: {{ primary }} !important; }
body .gLFyf::placeholder { color: {{ foreground }}80 !important; }
body .izN7If:hover:not(:disabled),
body .izN7If:focus:not(:disabled) { background: {{ muted }}66 !important; }
body .EpPYLd, body g-menu, body g-popup .UjBGL { background: {{ background_alt }} !important; color: {{ foreground }} !important; }
body .CjiZvb, body .GZnQqe.EpPYLd:active { background-color: {{ muted }}66 !important; }
body .Ij8KCd, body .O3yKUb { background: {{ background_alt }} !important; border-color: {{ muted }} !important; }
body .eQtdDf, body a.eQtdDf { color: {{ foreground }} !important; }
body .b77HKf { background-color: {{ background_alt }} !important; }
body .Txngnb { color: {{ foreground }} !important; }
body .xab99e .niO4u.niO4u { background: {{ background_alt }} !important; border-color: {{ muted }} !important; }
body .ynRric { color: {{ foreground }}b3 !important; }
body .plR5qb .bvUkz { --aim-button-gradient-start: {{ background_alt }} !important; --aim-button-gradient-end: {{ background_alt }} !important; }

/* ---- Search results page (/search) ---- */
body #main, body #cnt, body #rcnt, body #center_col, body #rso, body #search,
body #topstuff, body #botstuff, body #bres, body #appbar, body #slim_appbar,
body #top_nav, body #hdtb, body #searchform, body #sfooter, body #footcnt,
body #fbar, body #fbarcnt, body #lfootercc, body #before-appbar, body #atvcap {
  background: {{ background }} !important;
  color: {{ foreground }} !important;
  border-color: {{ muted }} !important;
}
body #searchform, body #searchform .sfbg, body #searchform form#tsf { background: {{ background }} !important; box-shadow: none !important; }
body #hdtb, body #hdtb-msb { border-bottom-color: {{ muted }} !important; }
body #result-stats, body #hdtb-tls, body #hdtb-tls * { color: {{ foreground }}b3 !important; }

/* Result entries */
body #rso a h3, body #rso h3.LC20lb { color: {{ primary }} !important; }
body #rso a:visited h3 { color: {{ secondary }} !important; }
body #rso cite, body #rso .tjvcx, body #rso .qLRx3b, body #rso .VuuXrf { color: {{ foreground }}b3 !important; }
body #rso .VwiC3b, body #rso .VwiC3b *, body #rso .byrV5b { color: {{ foreground }} !important; }
body #rso .VwiC3b em, body #rso .VwiC3b b { color: {{ warning }} !important; }
body #rso .MjjYud, body #rso .kb0PBd { background: transparent !important; }

/* Right panel, related searches, pagination, footer */
body #botstuff a, body #foot a, body #fbar a, body #sfooter a { color: {{ primary }} !important; }
body #fbar, body #fbar *, body #sfooter { color: {{ foreground }}b3 !important; }
body #sfooter, body #fbar { border-color: {{ muted }} !important; }
body #botstuff td a, body #botstuff .SJajHc { color: {{ primary }} !important; }
body #botstuff .YyVfkd { color: {{ foreground }} !important; }
`;

  const inject = () => {
    const style = document.createElement('style');
    style.id = 'theme-google';
    style.textContent = CSS;
    (document.head || document.documentElement).appendChild(style);
  };
  // At document-start the root element may not exist yet; wait for it.
  if (document.documentElement) {
    inject();
  } else {
    new MutationObserver((_, obs) => {
      if (document.documentElement) { obs.disconnect(); inject(); }
    }).observe(document, { childList: true });
  }
})();
