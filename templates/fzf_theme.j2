# Generado por theme_manager.py — no editar a mano, se sobreescribe en cada `theme set`.
# Los colores viven en ~/.fzf_opts (fzf_opts.j2), que fzf lee en cada
# ejecución. Se hace unset de FZF_DEFAULT_OPTS porque los procesos que
# arrancaron con un tema anterior (p. ej. el servidor de herdr) la heredan
# congelada, y fzf la aplica encima del archivo.
unset FZF_DEFAULT_OPTS
export FZF_DEFAULT_OPTS_FILE="$HOME/.fzf_opts"

# Sin colores: fzf aplica primero FZF_DEFAULT_OPTS_FILE y después esto.
export FZF_CTRL_R_OPTS="
  --height=60%
  --layout=reverse
  --border=rounded
  --prompt='󰋚  History > '
  --pointer='▶'
  --marker='✓'
"
