// ==UserScript==
// @name         GitHub theme
// @description  Generated by theme_manager.py from the active palette. Do not edit by hand.
// @match        *://github.com/*
// @match        *://*.github.com/*
// @run-at       document-start
// ==/UserScript==

(function () {
  const CSS = `
/* Primer dark-mode tokens reassigned to the active theme palette. */
html,
[data-color-mode] {
  color-scheme: dark !important;

  /* Surfaces */
  --bgColor-default: {{ background }} !important;
  --bgColor-muted: {{ background_alt }} !important;
  --bgColor-inset: {{ background }} !important;
  --bgColor-emphasis: {{ muted }} !important;
  --bgColor-neutral-muted: {{ background_alt }} !important;
  --bgColor-neutral-emphasis: {{ muted }} !important;
  --bgColor-accent-muted: {{ primary }}26 !important;
  --bgColor-accent-emphasis: {{ primary }} !important;
  --bgColor-success-muted: {{ success }}26 !important;
  --bgColor-success-emphasis: {{ success }} !important;
  --bgColor-open-muted: {{ success }}26 !important;
  --bgColor-open-emphasis: {{ success }} !important;
  --bgColor-danger-muted: {{ alert }}26 !important;
  --bgColor-danger-emphasis: {{ alert }} !important;
  --bgColor-closed-muted: {{ alert }}26 !important;
  --bgColor-closed-emphasis: {{ alert }} !important;
  --bgColor-attention-muted: {{ warning }}26 !important;
  --bgColor-attention-emphasis: {{ warning }} !important;
  --overlay-bgColor: {{ background_alt }} !important;

  /* Text */
  --fgColor-default: {{ foreground }} !important;
  --fgColor-muted: {{ muted }} !important;
  --fgColor-accent: {{ primary }} !important;
  --fgColor-link: {{ primary }} !important;
  --fgColor-success: {{ success }} !important;
  --fgColor-open: {{ success }} !important;
  --fgColor-danger: {{ alert }} !important;
  --fgColor-closed: {{ alert }} !important;
  --fgColor-attention: {{ warning }} !important;
  --fgColor-onEmphasis: {{ background }} !important;

  /* Borders */
  --borderColor-default: {{ muted }} !important;
  --borderColor-muted: {{ muted }}80 !important;
  --borderColor-emphasis: {{ muted }} !important;
  --borderColor-neutral-muted: {{ muted }}80 !important;
  --borderColor-accent-muted: {{ primary }}66 !important;
  --borderColor-accent-emphasis: {{ primary }} !important;
  --borderColor-success-muted: {{ success }}66 !important;
  --borderColor-success-emphasis: {{ success }} !important;
  --borderColor-danger-muted: {{ alert }}66 !important;
  --borderColor-danger-emphasis: {{ alert }} !important;
  --borderColor-attention-muted: {{ warning }}66 !important;
  --borderColor-attention-emphasis: {{ warning }} !important;

  /* Header */
  --header-bgColor: {{ background_alt }} !important;
  --header-fgColor-default: {{ foreground }} !important;
  --header-fgColor-logo: {{ primary }} !important;
  --header-borderColor-divider: {{ muted }} !important;

  /* Buttons */
  --button-default-bgColor-rest: {{ background_alt }} !important;
  --button-default-bgColor-hover: {{ background }} !important;
  --button-default-borderColor-rest: {{ muted }} !important;
  --button-default-fgColor-rest: {{ foreground }} !important;
  --button-primary-bgColor-rest: {{ primary }} !important;
  --button-primary-bgColor-hover: {{ primary }}d9 !important;
  --button-primary-bgColor-active: {{ primary }}bf !important;
  --button-primary-borderColor-rest: {{ primary }} !important;
  --button-primary-fgColor-rest: {{ background }} !important;

  /* Focus and selection */
  --focus-outlineColor: {{ primary }} !important;
  --selection-bgColor: {{ primary }}59 !important;

  /* Legacy tokens still referenced by some surfaces */
  --color-canvas-default: {{ background }} !important;
  --color-canvas-subtle: {{ background_alt }} !important;
  --color-canvas-inset: {{ background }} !important;
  --color-fg-default: {{ foreground }} !important;
  --color-fg-muted: {{ muted }} !important;
  --color-fg-subtle: {{ muted }} !important;
  --color-fg-on-emphasis: {{ background }} !important;
  --color-border-default: {{ muted }} !important;
  --color-border-muted: {{ muted }}80 !important;
  --color-accent-fg: {{ primary }} !important;
  --color-accent-emphasis: {{ primary }} !important;
  --color-accent-muted: {{ primary }}66 !important;
  --color-accent-subtle: {{ primary }}26 !important;
  --color-attention-muted: {{ warning }}66 !important;
  --color-attention-subtle: {{ warning }}26 !important;
  --color-header-bg: {{ background_alt }} !important;
  --color-header-text: {{ foreground }} !important;
}

body { background-color: {{ background }} !important; color: {{ foreground }} !important; }
`;

  const inject = () => {
    const style = document.createElement('style');
    style.id = 'theme-github';
    style.textContent = CSS;
    (document.head || document.documentElement).appendChild(style);
  };
  // At document-start the root element may not exist yet; wait for it.
  if (document.documentElement) {
    inject();
  } else {
    new MutationObserver((_, obs) => {
      if (document.documentElement) { obs.disconnect(); inject(); }
    }).observe(document, { childList: true });
  }
})();
